# ── Node ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8081

# ── Database ────────────────────────────────────────────────────────────────
# Neon: use pooled URL for runtime, direct URL for prisma migrate
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-64-byte-hex-secret-minimum-32-chars"
JWT_EXPIRES_IN="7d"

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated. Add your Vercel URL here when deploying.
FRONTEND_URL="http://localhost:3000"

# ── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── SMTP (Gmail example) ────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Lhasa Books <your-email@gmail.com>"
